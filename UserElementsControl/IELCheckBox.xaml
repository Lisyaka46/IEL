<Base:IELContainerBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="LibraryIEL.UserElementsControl.IELCheckBox"
    xmlns:Base="clr-namespace:LibraryIEL.UserElementsControl.Base"
    xmlns:IEL="clr-namespace:LibraryIEL.UserElementsControl"
    HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand">
    <Grid x:FieldModifier="private" x:Name="MainContainer">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border x:FieldModifier="private" x:Name="BorderCheck" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" BorderBrush="Black" Width="{Binding ActualHeight, ElementName=ViewBoxText}" Height="{Binding ActualHeight, ElementName=ViewBoxText}" Padding="2,2,2,2" Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle x:FieldModifier="private" x:Name="RectangleCheck" RadiusX="3" RadiusY="3" Fill="Black"/>
        </Border>
        <Viewbox x:FieldModifier="private" x:Name="ViewBoxText" Grid.Column="1" Margin="0,3,0,3" StretchDirection="DownOnly" Stretch="UniformToFill" VerticalAlignment="Center">
            <TextBlock x:FieldModifier="private" x:Name="TextBlockElement" Text="Name" Padding="3,2,5,2"/>
        </Viewbox>
    </Grid>
</Base:IELContainerBase>
