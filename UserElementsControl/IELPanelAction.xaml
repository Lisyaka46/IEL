<Base:IELContainerBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="LibraryIEL.UserElementsControl.IELPanelAction"
    xmlns:Base="clr-namespace:LibraryIEL.UserElementsControl.Base"
    xmlns:IEL="clr-namespace:LibraryIEL.UserElementsControl"
    Focusable="True" IsAnimatedSettingQ="False">
    <Grid x:Name="GridActionPanel" Focusable="True">
        <Viewbox VerticalAlignment="Top" HorizontalAlignment="Center">
            <IEL:IELContentController x:Name="MainPageController"/>
        </Viewbox>
        <TextBlock x:Name="TextBlockRightButtonIndicatorKey" HorizontalAlignment="Right" Text="0" VerticalAlignment="Bottom" Panel.ZIndex="2" FontFamily="Bahnschrift SemiBold" FontSize="16" Foreground="White" TextTrimming="WordEllipsis" TextAlignment="Right"/>
    </Grid>
</Base:IELContainerBase>
