<Base:IELContainerBase
    x:Class="IEL.UserElementsControl.IELTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base" Focusable="True" Cursor="IBeam" ClipToBounds="True" Width="22">
    <Grid Margin="0,1,1,1">
        <TextBlock x:FieldModifier="private" x:Name="TextBlockVisualText" FontSize="14" HorizontalAlignment="Left"/>
        <Rectangle StrokeThickness="1" Stroke="Black" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Panel.ZIndex="1" RadiusX="1" RadiusY="1" StrokeDashArray="1" Grid.Column="1" Width="13" HorizontalAlignment="Left" Opacity="0"/>
        <Line x:FieldModifier="private" x:Name="CaretLine" Y1="0" Y2="1" Stroke="Black" StrokeThickness="1.2" Stretch="Uniform" Panel.ZIndex="1" StrokeEndLineCap="Triangle" StrokeStartLineCap="Triangle" HorizontalAlignment="Left" StrokeDashCap="Triangle" StrokeDashOffset="-0.5" Margin="1,0,0,0"/>
    </Grid>
</Base:IELContainerBase>
